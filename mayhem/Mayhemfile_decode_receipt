# nearcore in-process libFuzzer target (cargo-fuzz / libfuzzer-sys).
# Feeds fuzz bytes into near_primitives' receipt decoder
# (borsh::from_slice::<ReceiptOrStateStoredReceipt>), whose hand-written
# deserialize_reader peeks the first two bytes and discriminates between a legacy
# Receipt::V0 and a 0xFF 0xFF-tagged StateStoredReceipt, then asserts borsh's
# canonical round-trip on any input that decodes.
project: savantenvs/nearcore
target: decode_receipt
image: savantenvs/nearcore:latest

cmds:
  - cmd: /mayhem/decode_receipt
    libfuzzer: true

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/decode_receipt/testsuite
